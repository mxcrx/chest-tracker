{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "chest-tracker",
  "version": "0.1.0",
  "identifier": "de.mxcrx.chesttracker",
  "build": {
    "frontendDist": "../desktop/renderer",
    "beforeDevCommand": "npm run server"
  },
  "app": {
    "windows": [
      {
        "title": "Chest Tracker",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#080b16",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
